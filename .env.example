# ─────────────────────────────────────────────────────────────────────────────
# NeutraleNachrichten — environment configuration
# Copy to .env.local for development. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required in production ───────────────────────────────────────────────────
# PostgreSQL (pgvector extension enables semantic search; without it the app
# degrades to full-text search only).
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Railway private network URL — preferred when present (no egress cost).
DATABASE_PRIVATE_URL=

# Google Gemini — analysis, NLI verification and embeddings. Server-side only:
# never expose this to the browser.
GEMINI_API_KEY=your_gemini_api_key_here

# JWT signing secret. The server REFUSES TO START in production if this is unset
# or left at the development default — a predictable signing key is worse than
# not booting at all.
JWT_SECRET=change_me_to_a_long_random_string

# ── Corpus & retrieval ───────────────────────────────────────────────────────
# Use the stored corpus instead of live RSS per request (Corpus V2 path).
CORPUS_ANALYSIS_ENABLED=true
# Minimum corpus hits for a topic before falling back to live RSS.
CORPUS_MIN_ARTICLES=8
# Articles per camp sent to the model. Display is uncapped — this bounds AI work
# and latency only, never the honesty of shown coverage.
GEMINI_MAX_PER_SPECTRUM=12
EMBEDDING_MODEL=gemini-embedding-001

# ── Ingestion worker (separate Railway service: node worker.js) ───────────────
INGEST_INTERVAL_MINUTES=30
INGEST_MAX_AGE_DAYS=7
CORPUS_RETENTION_DAYS=180
CLUSTERING_ENABLED=false
CLUSTERING_WINDOW_DAYS=3

# ── Cost & concurrency guards ────────────────────────────────────────────────
# Hard cap on model calls per UTC day — protection against a surprise bill.
GEMINI_DAILY_BUDGET=500
MAX_CONCURRENT_GEMINI=6
FREE_DAILY_LIMIT=10
ANALYZE_RATE_PER_MIN=10
FEEDBACK_RATE_PER_MIN=20

# ── Cache & rate-limit store (optional) ──────────────────────────────────────
# Without Redis the app still works: cache falls back to memory + PostgreSQL and
# rate limits become per-process instead of shared.
REDIS_URL=
UPSTASH_REDIS_URL=

# ── Admin ────────────────────────────────────────────────────────────────────
# Guards /api/admin/* (header x-admin-key). Empty = admin endpoints refuse all.
ADMIN_KEY=
ADMIN_SECRET=

# Traction analytics: comma-separated ip_hash values to exclude as internal
# traffic. With a small user base the team's own testing dominates every metric,
# so the admin dashboard hides its numbers behind a warning until this is set.
# The dashboard shows your current hash — copy it in (one per device).
INTERNAL_IP_HASHES=

# ── Auth & email ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
FROM_EMAIL=noreply@neutralenachrichten.com
BASE_URL=http://localhost:3000

# ── Networking & monitoring ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Comma-separated CORS allowlist. Defaults to the production domains.
CORS_ORIGINS=https://neutralenachrichten.com,https://www.neutralenachrichten.com
# Number of trusted proxy hops (Railway terminates TLS in front of the app).
TRUSTED_PROXY_HOPS=1
SENTRY_DSN=

# ── Frontend (Vite — these ARE bundled into the browser build) ────────────────
# Only ever put public values here. Never an API key with real privileges.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_API_URL=
